# Used by `docker compose up` (copy to .env in the repo root). Never commit .env.
# Supabase: Project Settings > API. Use the SECRET (service-role) key, never the anon key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# One long random string, shared by the shop and RuleLock. Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RULELOCK_API_TOKEN=
# Leave 0 for the real demo. 1 = fake RuleLock for quick local UI tests only (ignored in production and on Render).
RULELOCK_MOCK=0
