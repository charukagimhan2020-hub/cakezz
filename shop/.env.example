# Cakezz shop (PHP). Copy to shop/.env for `php -S` runs; on Render set these as environment variables.
# Never commit the real values. (docker compose uses the .env in the repo ROOT instead.)

# Supabase (Project Settings > API). Use the SECRET (service-role) key, never the anon key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# RuleLock service (Flask). Locally with docker compose: http://rulelock:5001. On Render: its public URL.
RULELOCK_URL=http://localhost:5001
# Must be the same value as RULELOCK_API_TOKEN of the RuleLock service
RULELOCK_API_TOKEN=change-me-long-random-string

# development = RULELOCK_MOCK may be used. production (the Docker image default, and on Render) ignores RULELOCK_MOCK.
APP_ENV=development
# 1 = fake RuleLock inside the shop and the monitor (local tests only). Always 0 for the real demo.
RULELOCK_MOCK=0
