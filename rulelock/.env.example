# RuleLock (one Flask process: c1 imports c2, c3, c4). Copy to rulelock/.env for local runs.
# On Render set these as environment variables. Never commit real values.

# ---- c1 (app) ----
PORT=5001
APP_ENV=development                 # the Docker image sets production, which REQUIRES RULELOCK_API_TOKEN
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=                # the secret / service-role key, never the anon key
RULELOCK_API_TOKEN=change-me-long-random-string     # same value as in shop/.env
RULELOCK_ALLOW_NO_AUTH=0            # 1 = no token needed. Local development only
CORS_ORIGINS=                       # empty = CORS off (the PHP shop calls RuleLock from its server)
MAX_BODY_BYTES=65536
EVENT_MAX_BYTES=8192
WEB_CONCURRENCY=1                   # gunicorn workers (Render free: 1 or 2)

# ---- c2 rule engine ----
MAX_COUPONS=1
MAX_DISCOUNT_RATIO=0.6
MAX_QUANTITY_PER_LINE=20
MIN_PURCHASE_AMOUNT=500
PRICE_MATCH_TOLERANCE=0.01
TOTAL_TOLERANCE=1
COD_UNVERIFIED_ORDER_CAP=15000
COD_BAD_HOLD=2
COD_BAD_REJECT=3
COD_BAD_RATIO=0.5
COUPON_VELOCITY_MAX_REVIEWS=5

# ---- c3 anomaly detection ----
ANOMALY_HOLD_THRESHOLD=-0.06
ANOMALY_REJECT_THRESHOLD=-0.1
MODEL_PATH=                         # empty = c3-anomaly-detection/model.joblib (created at build)

# ---- c4 enforcement ----
RATE_LIMIT_MINUTES=30
